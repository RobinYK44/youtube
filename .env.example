# ---- Discord ----
DISCORD_TOKEN=
# Kanaal waar de bot updates plaatst (rechtermuisknop op kanaal -> "Kanaal-ID kopiëren")
DISCORD_CHANNEL_ID=

# ---- Twitch (https://dev.twitch.tv/console/apps) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- YouTube ----
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
# public / unlisted / private
YOUTUBE_PRIVACY=public

# ---- Welke streamers ----
# Vaste lijst (Twitch-loginnamen, komma-gescheiden)
STREAMERS=jynxzi,kaicenat,caseoh_,xqc,stableronaldo,lacy,fanum,adapt
# Daarnaast automatisch de N grootste live streamers van dit moment meenemen (0 = uit)
AUTO_DISCOVER_TOP=5
# Taal voor automatisch zoeken (en, nl, ...) — leeg = alle talen
DISCOVER_LANGUAGE=en

# ---- Planning ----
# Max 6 per dag i.v.m. YouTube API-quota (1 upload = 1600 van 10.000 punten)
UPLOADS_PER_DAY=4
# true = bot vraagt eerst in Discord om goedkeuring (✅/❌), false = volledig automatisch
APPROVAL_MODE=false

# ---- Clips ----
# Hoeveel dagen terug zoeken naar clips
CLIP_LOOKBACK_DAYS=2
MIN_CLIP_VIEWS=500
MAX_SHORT_SECONDS=60
# Optioneel: pad naar een .ttf lettertype voor de titel in beeld (leeg = automatisch zoeken)
FONT_PATH=
