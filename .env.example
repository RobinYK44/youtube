# ---- Discord ----
DISCORD_TOKEN=
# Kanaal waar de bot updates plaatst (rechtermuisknop op kanaal -> "Kanaal-ID kopiëren")
DISCORD_CHANNEL_ID=

# ---- Twitch (https://dev.twitch.tv/console/apps) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- YouTube ----
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
# public / unlisted / private
YOUTUBE_PRIVACY=public

# ---- TikTok (optioneel, https://developers.tiktok.com) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Welke streamers ----
# Vaste lijst (Twitch-loginnamen, komma-gescheiden)
STREAMERS=jynxzi,kaicenat,caseoh_,xqc,stableronaldo,lacy,fanum,adapt
# Daarnaast automatisch de N grootste live streamers van dit moment meenemen (0 = uit)
AUTO_DISCOVER_TOP=5
# Taal voor automatisch zoeken (en, nl, ...) — leeg = alle talen
DISCOVER_LANGUAGE=en

# ---- Planning ----
# Tijden waarop de shorts online komen (max 6 per dag i.v.m. YouTube API-quota).
# De bot uploadt ze van tevoren, dus ze komen ook online als je computer uit staat.
PUBLISH_TIMES=18:00,21:00,00:00,02:00
TIMEZONE=Europe/Amsterdam
# Kiesmodus: zoveel shorts per dag maken, jij kiest in Discord welke online gaan (0 = volledig automatisch).
# Kan ook in Discord met /kiesmodus.
CANDIDATES_PER_DAY=0

# ---- Clips ----
# Hoeveel dagen terug zoeken naar clips
CLIP_LOOKBACK_DAYS=2
MIN_CLIP_VIEWS=500
MIN_CLIP_SECONDS=10
MAX_SHORT_SECONDS=60
# Langere clips worden ingekort tot ongeveer zoveel seconden (het einde blijft, daar zit meestal het moment)
TARGET_SHORT_SECONDS=35
# Kiesmodus: zoveel compilaties (3 grappige momenten in één short) per dag erbij
COMPILATIONS_PER_DAY=1
COMPILATION_PART_SECONDS=18
# Optioneel: pad naar een .ttf lettertype voor de titel in beeld (leeg = automatisch zoeken)
FONT_PATH=
